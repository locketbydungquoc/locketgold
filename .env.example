# ───────── Neon Postgres ─────────
# Lấy từ console.neon.tech → Connect → chọn Pooled
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# ───────── SePay webhook ─────────
# Đặt chuỗi random, dùng để verify request từ SePay
SEPAY_WEBHOOK_SECRET=your_random_secret_here

# ───────── Ngân hàng nhận tiền ─────────
# BIN: MB=970422, VCB=970436, TCB=970407, ACB=970416
BANK_BIN=970422
BANK_ACC=0123456789
BANK_HOLDER=NGUYEN VAN A

# ───────── Telegram ─────────
# Token lấy từ @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Chat ID admin — lấy từ @userinfobot
TELEGRAM_ADMIN_CHAT_ID=1234567890

# ───────── NextDNS ─────────
# Key: dashboard.nextdns.io → Account
# Profile: dashboard.nextdns.io → chọn profile → copy ID 6 ký tự
NEXTDNS_KEY=your_nextdns_api_key
NEXTDNS_PROFILE=xxxxxx

# ───────── Bot activation webhook ─────────
# Để trống nếu chưa có endpoint tự động kích Gold
BOT_ACTIVATION_WEBHOOK=
BOT_ACTIVATION_SECRET=
